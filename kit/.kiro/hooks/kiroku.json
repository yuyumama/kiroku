{
  "version": "v1",
  "hooks": [
    {
      "name": "kiroku-record-tool",
      "description": "シェル実行の失敗、テスト結果、書き込みを .kiro/kiroku/data/events.jsonl に記録する",
      "trigger": "PostToolUse",
      "action": {
        "type": "command",
        "command": "python3 .kiro/skills/kiroku-retro/scripts/record.py"
      },
      "timeout": 30
    },
    {
      "name": "kiroku-record-file",
      "description": "エージェントが保存したファイルのパスと内容ハッシュを記録する",
      "trigger": "PostFileSave",
      "action": {
        "type": "command",
        "command": "python3 .kiro/skills/kiroku-retro/scripts/record.py"
      },
      "timeout": 30
    },
    {
      "name": "kiroku-record-prompt",
      "description": "発話のタイミングを記録する（本文は保存しない）",
      "trigger": "UserPromptSubmit",
      "action": {
        "type": "command",
        "command": "python3 .kiro/skills/kiroku-retro/scripts/record.py"
      },
      "timeout": 30
    }
  ]
}
