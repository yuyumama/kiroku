{
  "version": "v1",
  "hooks": [
    {
      "name": "kiroku-probe-session-start",
      "trigger": "SessionStart",
      "action": { "type": "command", "command": "python3 .kiro/kiroku-probe/dump.py SessionStart" },
      "timeout": 10
    },
    {
      "name": "kiroku-probe-session-end",
      "trigger": "SessionEnd",
      "action": { "type": "command", "command": "python3 .kiro/kiroku-probe/dump.py SessionEnd" },
      "timeout": 10
    },
    {
      "name": "kiroku-probe-prompt",
      "trigger": "UserPromptSubmit",
      "action": { "type": "command", "command": "python3 .kiro/kiroku-probe/dump.py UserPromptSubmit" },
      "timeout": 10
    },
    {
      "name": "kiroku-probe-pre-tool",
      "trigger": "PreToolUse",
      "action": { "type": "command", "command": "python3 .kiro/kiroku-probe/dump.py PreToolUse" },
      "timeout": 10
    },
    {
      "name": "kiroku-probe-post-tool",
      "trigger": "PostToolUse",
      "action": { "type": "command", "command": "python3 .kiro/kiroku-probe/dump.py PostToolUse" },
      "timeout": 10
    },
    {
      "name": "kiroku-probe-stop",
      "trigger": "Stop",
      "action": { "type": "command", "command": "python3 .kiro/kiroku-probe/dump.py Stop" },
      "timeout": 10
    }
  ]
}
