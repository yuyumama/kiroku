{
  "version": "v1",
  "hooks": [
    {
      "name": "kiroku-probe-file-create",
      "trigger": "PostFileCreate",
      "action": { "type": "command", "command": "python3 .kiro/kiroku-probe/dump.py PostFileCreate" },
      "timeout": 10
    },
    {
      "name": "kiroku-probe-file-save",
      "trigger": "PostFileSave",
      "action": { "type": "command", "command": "python3 .kiro/kiroku-probe/dump.py PostFileSave" },
      "timeout": 10
    },
    {
      "name": "kiroku-probe-file-delete",
      "trigger": "PostFileDelete",
      "action": { "type": "command", "command": "python3 .kiro/kiroku-probe/dump.py PostFileDelete" },
      "timeout": 10
    }
  ]
}
